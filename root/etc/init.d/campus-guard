#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
    [ "$(uci -q get campus_guard.main.enabled)" = "1" ] || return 0
    procd_open_instance
    procd_set_param command /bin/sh /usr/share/campus-guard/loop.sh
    procd_set_param respawn 3600 5 5
    procd_set_param stderr 1
    procd_close_instance
}
service_triggers() {
    procd_add_reload_trigger campus_guard
}
